#!/usr/bin/env python3
# description: Smart plugs (Shelly)
# menu: dynamic
# menu-depends: .secrets/plugs.conf
# shortcuts-only: yes
"""Bot command for Shelly smart plugs (Gen2/Gen3/Gen4 local RPC API, no cloud).

/plugs shows all plugs with buttons (BUTTON: lines, turned into Telegram buttons by shield-bot):
"On" for a plug that's off, "Off" and "Power cycle" (both ask for confirmation) for one that's on.
The buttons run shortcuts generated per plug from plugs.conf, which also work when typed but are
not listed in Telegram's menu:

  /plug_pc              status of plug "pc"
  /plug_pc_on           switch on
  /plug_pc_off          switch off
  /plug_pc_toggle       toggle
  /plug_pc_cycle        power cycle: off for the plug's cycle time, then on again

Plugs are configured in /root/workspace/.secrets/plugs.conf (chmod 600), one per line:

  # number  name   ip              [cycle_seconds]  [password]
  1         pc     192.168.1.50    60
  2         lamp   192.168.1.51

"cycle-start" (for other commands, e.g. pcctl) only starts the cycle and returns at once.

"cycle" uses the plug's own timer (Switch.Set with toggle_after), so the off time is exact
even if the network is slow. Default 60 s: a PC set to "power on after AC loss" needs the
power off long enough for its supply to drain (30 s was not enough on an ASRock B850M).
"""
import json
import re
import sys
import time
import urllib.error
import urllib.request

CONF = "/root/workspace/.secrets/plugs.conf"
ACTIONS = ("on", "off", "toggle", "cycle", "cycle-start", "status", "list")
DEFAULT_CYCLE = 60          # long enough for a PC's power supply to register a real power loss


def load_plugs():
    plugs = []
    try:
        lines = open(CONF).read().splitlines()
    except FileNotFoundError:
        sys.exit(f"No plugs configured: create {CONF} (see the comment in this command).")
    for line in lines:
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        f = line.split()
        if len(f) < 3:
            sys.exit(f"Bad line in {CONF}: {line!r} (need: number name ip [cycle_seconds] [password])")
        plugs.append({"num": f[0], "name": f[1].lower(), "host": f[2],
                      "cycle": int(f[3]) if len(f) > 3 and f[3].isdigit() else DEFAULT_CYCLE,
                      "password": f[4] if len(f) > 4 else ""})
    if not plugs:
        sys.exit(f"No plugs configured in {CONF}.")
    return plugs


def rpc(plug, method, **params):
    query = "&".join(f"{k}={str(v).lower() if isinstance(v, bool) else v}" for k, v in params.items())
    url = f"http://{plug['host']}/rpc/{method}" + (f"?{query}" if query else "")
    handlers = []
    if plug["password"]:
        pm = urllib.request.HTTPPasswordMgrWithDefaultRealm()
        pm.add_password(None, f"http://{plug['host']}/", "admin", plug["password"])
        handlers.append(urllib.request.HTTPDigestAuthHandler(pm))
    try:
        with urllib.request.build_opener(*handlers).open(url, timeout=8) as r:
            return json.load(r)
    except (urllib.error.URLError, OSError) as e:
        raise RuntimeError(f"can't reach {plug['name']} at {plug['host']} ({e})")


def describe(plug, s):
    parts = [f"{plug['num']} {plug['name']}: {'ON' if s.get('output') else 'OFF'}"]
    if s.get("apower") is not None:
        parts.append(f"{s['apower']:.1f} W")
    temp = (s.get("temperature") or {}).get("tC")
    if temp is not None:
        parts.append(f"{temp:.0f} °C")
    energy = (s.get("aenergy") or {}).get("total")
    if energy is not None:
        parts.append(f"{energy / 1000:.2f} kWh")
    return " · ".join(parts)


def status(plug, states=None):
    try:
        s = rpc(plug, "Switch.GetStatus", id=0)
    except RuntimeError as e:
        return f"{plug['num']} {plug['name']}: offline ({e})"
    if states is not None:
        states[plug["name"]] = bool(s.get("output"))
    return describe(plug, s)


def short_name(plug, action):
    slug = re.sub(r"[^a-z0-9_]", "_", plug["name"])
    return (f"plug_{slug}" if action == "status" else f"plug_{slug}_{action}")[:32]


def buttons(plugs, states):
    """BUTTON: lines for shield-bot: "/command | label [| confirm]"."""
    rows = []
    for p in plugs:
        on = states.get(p["name"])
        if on is None:                           # offline: no actions
            continue
        if on:
            rows += [f"/{short_name(p, 'off')} | {p['name']}: Off | confirm",
                     f"/{short_name(p, 'cycle')} | {p['name']}: Power cycle | confirm"]
        else:
            rows.append(f"/{short_name(p, 'on')} | {p['name']}: On")
    rows.append("/plugs | Refresh")
    print("\n".join("BUTTON: " + r for r in rows))


def print_menu(plugs):
    """Shortcuts (shortcut<TAB>args<TAB>description[<TAB>hidden]), read by shield-bot because
    of the "# menu: dynamic" header line. Only /plugs is listed in the menu; the per-plug
    shortcuts are reached through its buttons."""
    print("plugs\tstatus\tSmart plugs: status and controls")
    for p in plugs:
        label = p["name"]
        for action, desc in (("status", f"{label}: status and power"),
                             ("on", f"{label}: switch on"),
                             ("off", f"{label}: switch off"),
                             ("toggle", f"{label}: toggle on/off"),
                             ("cycle", f"{label}: power cycle (off {p['cycle']} s, then on)")):
            print(f"{short_name(p, action)}\t{p['name']} {action}\t{desc}\thidden")


def main():
    plugs = load_plugs()
    if sys.argv[1:] == ["--menu"]:
        print_menu(plugs)
        return
    args = [a.lower() for a in sys.argv[1:]]
    selector = args.pop(0) if args and args[0] not in ACTIONS else None
    action = args[0] if args else "status"
    if action not in ACTIONS or len(args) > 1:
        sys.exit("Unknown action - send /plugs and use its buttons")

    if action == "list":
        print("\n".join(f"{p['num']} {p['name']} - {p['host']} (cycle {p['cycle']} s)" for p in plugs))
        return
    if selector is None:
        if action == "status":
            states = {}
            print("\n".join(status(p, states) for p in plugs))
            buttons(plugs, states)
            return
        if len(plugs) > 1:
            sys.exit("Which plug? Use " + ", ".join(f"/plug_{p['name']}_{action}" for p in plugs))
        plug = plugs[0]
    else:
        match = [p for p in plugs if selector in (p["num"], p["name"])]
        if not match:
            sys.exit(f"No plug '{selector}'. Plugs: " + ", ".join(f"{p['num']} {p['name']}" for p in plugs))
        plug = match[0]

    try:
        if action == "status":
            print(status(plug))
        elif action in ("on", "off"):
            rpc(plug, "Switch.Set", id=0, on=(action == "on"))
            time.sleep(1)
            print(describe(plug, rpc(plug, "Switch.GetStatus", id=0)))
        elif action == "toggle":
            rpc(plug, "Switch.Toggle", id=0)
            time.sleep(1)
            print(describe(plug, rpc(plug, "Switch.GetStatus", id=0)))
        elif action == "cycle-start":                     # don't wait: the plug's timer does the rest
            n = max(3, plug["cycle"])
            rpc(plug, "Switch.Set", id=0, on=False, toggle_after=n)
            print(f"{plug['num']} {plug['name']}: OFF, back on in {n} s (plug timer)")
        elif action == "cycle":
            n = max(3, min(plug["cycle"], 100))   # the bot stops commands after 120 s
            # The plug switches off now and back on by itself after n seconds.
            rpc(plug, "Switch.Set", id=0, on=False, toggle_after=n)
            print(f"{plug['num']} {plug['name']}: OFF, back on in {n} s (plug timer)...", flush=True)
            time.sleep(n + 2)
            s = rpc(plug, "Switch.GetStatus", id=0)
            if not s.get("output"):                        # timer didn't fire: switch on explicitly
                rpc(plug, "Switch.Set", id=0, on=True)
                time.sleep(1)
            time.sleep(6)                                  # give the connected device time to start
            s = rpc(plug, "Switch.GetStatus", id=0)
            watts = s.get("apower") or 0
            print("Power cycle done: " + describe(plug, s)
                  + (" - something is drawing power (booting?)" if watts >= 5 else " - nothing drawing power yet"))
    except RuntimeError as e:
        sys.exit(str(e))
    if action != "cycle-start":                  # cycle-start is used by other commands (pcctl)
        print("BUTTON: /plugs | All plugs")


if __name__ == "__main__":
    main()
