#!/usr/bin/env python3
# description: Gaming PC: status, power, streaming
# menu: pc status | Gaming PC: status and controls
# shortcut: pc_on on | Gaming PC: turn on (plug power cycle, only if it's off)
# shortcut: pc_shutdown shutdown | Gaming PC: shut down cleanly
# shortcut: pc_reboot reboot | Gaming PC: reboot
# shortcut: pc_sunshine_restart sunshine-restart | Gaming PC: restart Sunshine (streaming)
# shortcut: pc_gamemode gamemode | Gaming PC: switch to Game Mode
# shortcut: pc_desktop desktop | Gaming PC: switch to Desktop Mode
# shortcuts-only: yes
"""Bot command for a gaming PC (Bazzite) at home, driven over SSH from the Shield.

/pc shows the status with buttons for what fits the PC's state (BUTTON: lines, turned into
Telegram buttons by shield-bot; shutdown, reboot and mode switches ask for confirmation).
The buttons run /pc_on, /pc_shutdown, /pc_reboot, /pc_sunshine_restart, /pc_gamemode and
/pc_desktop, which also work when typed but are not listed in Telegram's menu.

The PC side is examples/pc/shield-remote: the Shield's key may only run that script (forced
command in the PC's authorized_keys), which accepts one word per action.

Configuration in /root/workspace/.secrets/pc.conf (chmod 600), KEY=value lines:

  host=192.168.1.65            # the PC's fixed LAN address
  user=<user>                  # your user on the PC
  key=/root/.ssh/pc_bazzite    # private key of the Shield (ssh-keygen -t ed25519)
  plug=pc                      # plug name in plugs.conf, used by /pc_on (commands/plug)

/pc_on only power-cycles the plug when the PC is off: not reachable over SSH *and* drawing
less than ON_WATTS on the plug (a PC still shutting down closes SSH early). It replies at once;
the plug's own timer switches power back on.
"""
import re
import socket
import subprocess
import sys
import time

CONF = "/root/workspace/.secrets/pc.conf"
ACTIONS = ("status", "on", "shutdown", "reboot", "sunshine-restart", "gamemode", "desktop")
ON_WATTS = 10        # above this the PC is running, starting or shutting down


def load_conf():
    conf = {"user": "root", "key": "/root/.ssh/pc_bazzite", "plug": "pc"}
    try:
        for line in open(CONF):
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    except FileNotFoundError:
        sys.exit(f"Not configured: create {CONF} (see the comment in this command).")
    if "host" not in conf:
        sys.exit(f"Set host=<PC address> in {CONF}.")
    return conf


def up(conf, timeout=3):
    """True if the PC's SSH port answers."""
    try:
        socket.create_connection((conf["host"], 22), timeout=timeout).close()
        return True
    except OSError:
        return False


def wait(conf, want_up, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if up(conf) == want_up:
            return True
        time.sleep(3)
    return False


def remote(conf, action, timeout=40):
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                        "-o", "StrictHostKeyChecking=accept-new", "-i", conf["key"],
                        f"{conf['user']}@{conf['host']}", action],
                       capture_output=True, text=True, timeout=timeout)
    out = (r.stdout + r.stderr).strip()
    if r.returncode not in (0, 255) or (r.returncode == 255 and action == "status"):
        raise RuntimeError(out or f"ssh exit {r.returncode}")
    return out


def plug(conf, action):
    r = subprocess.run(["./commands/plug", conf["plug"], action], capture_output=True, text=True,
                       timeout=110, cwd="/root/workspace")
    # Drop plug's own buttons: /pc offers its own.
    return "\n".join(l for l in (r.stdout + r.stderr).splitlines() if not l.startswith("BUTTON:")).strip()


def watts(conf):
    """(power draw in W or None, plug status line)."""
    line = plug(conf, "status")
    m = re.search(r"([\d.]+) W", line)
    return (float(m.group(1)) if m else None), line


def wait_watts_below(conf, limit, seconds):
    end = time.time() + seconds
    while time.time() < end:
        w, line = watts(conf)
        if w is not None and w < limit:
            return line
        time.sleep(5)
    return None


def buttons(state, screen=""):
    """BUTTON: lines for shield-bot: "/command | label [| confirm]"."""
    if state == "off":
        rows = ["/pc_on | Turn on", "/pc | Refresh"]
    elif state == "on":
        rows = ["/pc | Refresh", "/pc_sunshine_restart | Restart Sunshine",
                "/pc_desktop | Desktop Mode | confirm" if screen == "Game Mode"
                else "/pc_gamemode | Game Mode | confirm",
                "/pc_reboot | Reboot | confirm", "/pc_shutdown | Shut down | confirm"]
    else:
        rows = ["/pc | Status"]
    print("\n".join("BUTTON: " + r for r in rows))


def show_status(conf):
    out = remote(conf, "status")
    print(out)
    m = re.search(r"^Screen:\s*(.+)$", out, re.M)
    buttons("on", m.group(1).strip() if m else "")


def main():
    conf = load_conf()
    action = (sys.argv[1] if len(sys.argv) > 1 else "status").lower()
    if action not in ACTIONS or len(sys.argv) > 2:
        sys.exit("Unknown action - send /pc and use its buttons")

    if action == "on":
        if up(conf):
            print("The PC is already on.")
            show_status(conf)
            return
        w, line = watts(conf)
        if w is not None and w >= ON_WATTS:
            print(f"Not cutting power: the PC draws {w:.0f} W, so it's still running, starting or "
                  "shutting down. Check again with /pc in a minute.\nPlug: " + line)
            buttons("after")
            return
        print(plug(conf, "cycle-start"))
        print("The PC boots right after power returns: check with /pc in about 2 minutes.")
        buttons("after")
        return

    if not up(conf):
        print("PC: off (or not reachable)")
        if action == "status":
            print("Plug: " + plug(conf, "status"))
        buttons("off")
        return

    if action == "status":
        show_status(conf)
        return
    elif action == "shutdown":
        print(remote(conf, "shutdown"), flush=True)
        if not wait(conf, False, 30):
            print("The PC is still reachable after 30 s - check /pc (an app may be blocking shutdown).")
            buttons("after")
            return
        line = wait_watts_below(conf, ON_WATTS, 80)    # SSH closes early; power draw tells when it's off
        print("PC is off. Plug: " + line if line else
              "SSH is down but the PC still draws power - check with /pc in a minute.")
    elif action == "reboot":
        print(remote(conf, "reboot"), flush=True)
        print("The PC is restarting - check with /pc in a minute or two." if wait(conf, False, 40)
              else "The PC didn't go down within 40 s - check /pc.")
    else:
        print(remote(conf, action))
    buttons("after")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.TimeoutExpired) as e:
        sys.exit(f"PC: {e}")
